# MongoDB Atlas (NoSQL) - string de conexão do cluster
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NOME=fiscalize_smartcity

# NeonDB (PostgreSQL relacional em nuvem) - string de conexão
NEON_DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/fiscalize_smartcity?sslmode=require
